# Google Gemini API Key (Required for reasoning & embeddings)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Google API Key alternative naming convention
GOOGLE_API_KEY="your_gemini_api_key_here"

# ChromaDB Server URL (Optional: defaults to local http://localhost:8000 if running, or uses local vector index)
CHROMA_URL=http://localhost:8000

# SQLite Database path (Defaults to ./data/tickets.db)
DATABASE_PATH=./data/tickets.db

# Gemini Models
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
